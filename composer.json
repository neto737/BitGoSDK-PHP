{
    "name": "neto737/bitgosdk-php",
    "description": "A BitGo SDK written in PHP",
    "type": "library",
    "keywords": ["bitgo", "sdk", "bitcoin"],
    "license": "MIT",

    "authors": [
        {
            "name": "Neto Melo",
            "email": "neto737@live.com"
        }
    ],

    "autoload": {
        "psr-4": {
            "neto737\\BitGoSDK\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "neto737\\BitGoSDK\\Tests\\": "tests/"
        }
    },

    "require": {
        "php": ">=7.0",
        "ext-curl": "*",
        "ext-bcmath": "*"
    },

    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.33"
    },

    "config": {
        "sort-packages": true
    }
}
