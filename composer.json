{
    "name": "neto737/bitgosdk-php",
    "description": "PHP client for the BitGo API and BitGo Express: wallets, addresses, transfers, webhooks and sending coins.",
    "type": "library",
    "keywords": ["bitgo", "bitgo-express", "sdk", "api-client", "bitcoin", "ethereum", "cryptocurrency", "wallet", "blockchain", "payments"],
    "homepage": "https://github.com/neto737/BitGoSDK-PHP",
    "license": "MIT",

    "authors": [
        {
            "name": "Neto Melo",
            "email": "neto737@live.com"
        }
    ],

    "support": {
        "issues": "https://github.com/neto737/BitGoSDK-PHP/issues",
        "source": "https://github.com/neto737/BitGoSDK-PHP",
        "security": "https://github.com/neto737/BitGoSDK-PHP/security/policy",
        "docs": "https://developers.bitgo.com/"
    },

    "funding": [
        {
            "type": "liberapay",
            "url": "https://liberapay.com/neto737"
        },
        {
            "type": "custom",
            "url": "https://www.paypal.com/donate/?business=T7RVRCXLZXB58&no_recurring=0&currency_code=USD"
        }
    ],

    "autoload": {
        "psr-4": {
            "neto737\\BitGoSDK\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "neto737\\BitGoSDK\\Tests\\": "tests/"
        }
    },

    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },

    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },

    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },

    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run PHPStan static analysis.",
        "cs": "Check the coding standard without changing files.",
        "cs:fix": "Fix coding standard violations.",
        "check": "Run the coding standard check, static analysis and tests."
    },

    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },

    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
